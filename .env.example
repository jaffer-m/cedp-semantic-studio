# ── Databricks connection ─────────────────────────────────────────────────
# Pre-fills the Connect form in the sidebar. Can also be typed in the UI.

DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
DATABRICKS_TOKEN=dapi...

# ── SQL Warehouse ─────────────────────────────────────────────────────────
# Required. Find it in: Databricks UI → SQL Warehouses → your warehouse
# -> Connection details -> last segment of the HTTP path.

DATABRICKS_WAREHOUSE_ID=your-warehouse-id

# ── Model serving endpoint ────────────────────────────────────────────────
# Optional. Defaults to databricks-meta-llama-3-3-70b-instruct.
# Override if your workspace (e.g. prod) uses a different endpoint name.
# Find available endpoints: Machine Learning -> Serving in the Databricks UI.

# DATABRICKS_SERVING_ENDPOINT=databricks-meta-llama-3-3-70b-instruct
