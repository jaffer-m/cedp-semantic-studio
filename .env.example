# ── Databricks auth ───────────────────────────────────────────────────────
# Your workspace URL (no trailing slash)
# e.g. https://adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_HOST=https://your-workspace.azuredatabricks.net

# Personal access token
# Databricks UI → top-right avatar → Settings → Developer → Access tokens → Generate new token
DATABRICKS_TOKEN=dapi...

# ── SQL Warehouse ─────────────────────────────────────────────────────────
# Databricks UI → SQL → Warehouses → click your warehouse → Connection details
# Copy the last segment of the HTTP path (e.g. if path is /sql/1.0/warehouses/abc123, use abc123)
DATABRICKS_WAREHOUSE_ID=your-warehouse-id
